---
import { Image } from "astro:assets";
import img from "../assets/3.jpg";
---

<section class="w-full py-16 md:py-24 px-6 md:px-16 bg-white overflow-hidden">
    <div data-aos="zoom-in" class="max-w-7xl mx-auto border-t border-gray-100 mb-12 md:mb-20"></div>

    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center gap-12 md:gap-16 lg:gap-24">
        
        <div class="w-full md:w-1/2" data-aos="fade-right" data-aos-duration="1200">
            <div class="rounded-[32px] md:rounded-[48px] overflow-hidden aspect-square md:aspect-[4/5] lg:aspect-square shadow-sm group">
                <Image src={img} alt="Abstract Spheres"  loading="eager" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" data-aos="zoom-out" data-aos-delay="200" />
            </div>
        </div>

        <div class="w-full md:w-1/2 space-y-8 md:space-y-10">
            <blockquote data-aos="fade-up"  data-aos-delay="400" class="text-2xl md:text-3xl lg:text-[40px] font-serif leading-[1.3] md:leading-[1.2] tracking-tight text-gray-900" >
                “I was skeptical, but <span class="text-[#8a9474]">Area</span> has completely transformed the way I manage my business. The data visualizations are so clear and intuitive, and the platform is so easy to use.”
            </blockquote>

            <div data-aos="fade-up" 
                data-aos-delay="600" 
                class="space-y-1 border-l-2 border-[#8a9474] pl-5">
                <p class="text-[13px] font-bold text-gray-900 tracking-tight">John Smith</p>
                <p class="text-[11px] font-mono font-bold text-[#8a9474] uppercase tracking-widest">Head of Data</p>
            </div>
        </div>
    </div>
</section>
