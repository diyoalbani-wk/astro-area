---
import { Image } from "astro:assets";
import img from "../assets/empat.jpg";
---

<section class="w-full px-6 md:px-16 pb-24 bg-white overflow-hidden">
    <div data-aos="fade-zoom-in" class="max-w-7xl mx-auto border-t border-gray-100 mb-12 md:mb-20"></div>

    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-16 md:mb-24 gap-6">
            <h2 data-aos="fade-right" class="text-4xl md:text-5xl lg:text-[64px] font-serif tracking-tighter leading-tight">
                Map Your Success
            </h2>
            <div data-aos="fade-left">
                <button class="bg-[#e2eccd] text-[#2d3816] px-8 md:px-10 py-3 rounded-full text-[13px] font-bold hover:bg-[#d5e2ba] transition-all hover:scale-105 active:scale-95 shadow-sm">
                    Discover More
                </button>
            </div>
        </div>

        <div class="overflow-x-auto lg:overflow-visible -mx-6 px-6 md:mx-0 md:px-0 mb-20 md:mb-32">
            <div class="flex lg:grid lg:grid-cols-3 gap-12 md:gap-16 min-w-[900px] lg:min-w-full">
                
                <div data-aos="fade-up" data-aos-delay="100" class="space-y-6 md:space-y-8 w-[280px] lg:w-full group">
                    <span class="text-7xl md:text-8xl font-medium text-gray-100 block tracking-tighter group-hover:text-[#e2eccd] transition-colors duration-500">01</span>
                    <div class="space-y-4">
                        <h3 class="text-[16px] font-bold text-gray-900 tracking-tight">Get Started</h3>
                        <p class="text-[14px] text-gray-500 leading-relaxed max-w-[280px]">
                            With our intuitive setup, you're up and running in minutes.
                        </p>
                    </div>
                </div>

                <div data-aos="fade-up" data-aos-delay="250" class="space-y-6 md:space-y-8 w-[280px] lg:w-full group">
                    <span class="text-7xl md:text-8xl font-medium text-gray-100 block tracking-tighter group-hover:text-[#e2eccd] transition-colors duration-500">02</span>
                    <div class="space-y-4">
                        <h3 class="text-[16px] font-bold text-gray-900 tracking-tight">Customize and Configure</h3>
                        <p class="text-[14px] text-gray-500 leading-relaxed max-w-[280px]">
                            Adapt Area to your specific requirements and preferences.
                        </p>
                    </div>
                </div>

                <div data-aos="fade-up" data-aos-delay="400" class="space-y-6 md:space-y-8 w-[280px] lg:w-full group">
                    <span class="text-7xl md:text-8xl font-medium text-gray-100 block tracking-tighter group-hover:text-[#e2eccd] transition-colors duration-500">03</span>
                    <div class="space-y-4">
                        <h3 class="text-[16px] font-bold text-gray-900 tracking-tight">Grow Your Business</h3>
                        <p class="text-[14px] text-gray-500 leading-relaxed max-w-[280px]">
                            Make informed decisions to exceed your goals.
                        </p>
                    </div>
                </div>

            </div>
        </div>

        <div class="w-full mt-10" data-aos="zoom-in-up" data-aos-duration="1000">
            <div class="rounded-[32px] md:rounded-[48px] overflow-hidden shadow-sm h-[600px] w-full group">
                <Image  src={img} alt="Success Roadmap" loading="eager" class="w-full h-full object-cover transition-transform duration-[2000ms] group-hover:scale-110"
                />
            </div>
        </div>

    </div>

    <div class="max-w-7xl mx-auto border-b border-gray-100 mt-24"></div>
</section>