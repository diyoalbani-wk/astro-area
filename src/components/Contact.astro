<section class="w-full px-6 bg-white">

    <div class="max-w-4xl mx-auto text-center space-y-10">
        <h2 class="text-5xl md:text-[64px] font-serif-heading tracking-tighter leading-tight">
            Connect with us
        </h2>
        
        <p class="text-gray-400 text-sm md:text-base max-w-lg mx-auto leading-relaxed">
            Schedule a quick call to learn how Area can turn your regional data into a powerful advantage.
        </p>

        <div id="magnetic-btn" class="pt-4">
            <button class="bg-[#415119] text-[#d9e7c3] w-full md:w-auto md:px-32 py-4 rounded-full text-[13px] font-bold hover:bg-[#323d13] transition-all shadow-sm">
                Learn More <span class="ml-1 opacity-70">↗</span>
            </button>
        </div>
    </div>
</section>

<script>
const btn = document.getElementById('magnetic-btn');
btn.addEventListener('mousemove', (e) => {
    const rect = btn.getBoundingClientRect();
    const x = e.clientX - rect.left - rect.width / 2;
    const y = e.clientY - rect.top - rect.height / 2;
    
    btn.style.transform = `translate(${x * 0.3}px, ${y * 0.5}px)`;
});

btn.addEventListener('mouseleave', () => {
    btn.style.transform = `translate(0px, 0px)`;
});

</script>